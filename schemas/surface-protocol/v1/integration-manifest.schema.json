{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/puritysb/AgentDeck/master/schemas/surface-protocol/v1/integration-manifest.schema.json",
  "title": "AgentDeck Surface integration manifest v1",
  "description": "Metadata and compatibility claims for an official or independent AgentDeck Surface integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "manifestStatus",
    "compatibilityTier",
    "ownership",
    "repository",
    "issues",
    "license",
    "maintainers",
    "profiles",
    "conformance"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/puritysb/AgentDeck/master/schemas/surface-protocol/v1/integration-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/reverseDnsId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "manifestStatus": {
      "enum": ["draft", "published"]
    },
    "compatibilityTier": {
      "enum": ["community", "verified-compatible", "official"]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "owner"],
      "properties": {
        "type": {
          "enum": ["independent", "agentdeck"]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "repository": {
      "$ref": "#/$defs/httpsUrl"
    },
    "issues": {
      "$ref": "#/$defs/httpsUrl"
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "products": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "compatibilityTier": {
            "const": "verified-compatible"
          }
        },
        "required": ["compatibilityTier"]
      },
      "then": {
        "properties": {
          "conformance": {
            "$ref": "#/$defs/passingConformance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "compatibilityTier": {
            "const": "official"
          }
        },
        "required": ["compatibilityTier"]
      },
      "then": {
        "properties": {
          "ownership": {
            "type": "object",
            "properties": {
              "type": {
                "const": "agentdeck"
              }
            },
            "required": ["type"]
          },
          "conformance": {
            "$ref": "#/$defs/passingConformance"
          }
        }
      }
    }
  ],
  "$defs": {
    "reverseDnsId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://"
    },
    "profileId": {
      "enum": [
        "dashboard-live/v1",
        "companion-control/v1",
        "portable-reader/v1",
        "display-only/v1"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transports", "capabilities", "legacyBaseline"],
      "properties": {
        "id": {
          "$ref": "#/$defs/profileId"
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["websocket", "http-pull", "http-outbox", "serial"]
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "legacyBaseline": {
          "type": "boolean"
        }
      }
    },
    "otaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "updateChannel"],
      "properties": {
        "board": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "updateChannel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "name", "defaultProfile"],
      "properties": {
        "productId": {
          "$ref": "#/$defs/reverseDnsId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "defaultProfile": {
          "$ref": "#/$defs/profileId"
        },
        "otaIdentities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/otaIdentity"
          }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["untested", "passed", "failed", "stale"]
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "evidence": {
          "$ref": "#/$defs/httpsUrl"
        },
        "daemonVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "passingConformance": {
      "type": "object",
      "required": [
        "status",
        "verifiedAt",
        "evidence",
        "daemonVersions",
        "manifestDigest"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "verifiedAt": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "daemonVersions": {
          "type": "array"
        },
        "manifestDigest": {
          "type": "string"
        }
      }
    }
  }
}
